# Copy this to .env in the backend directory
# NEVER commit actual .env with real values!

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Kaspa Network Configuration
KASPA_NETWORK=testnet
KASPA_REST_API=https://api.kaspa.org
KASPA_GRPC_SERVER=api.kaspa.org:16210

# Casino Wallet (KEEP SECRET!)
CASINO_KASPA_ADDRESS=kaspa:qr25pe5pfa4mhs8slw3dvxud4x55zx73tkz4xnpfyudnf7j8czzlsvf3vksdc
CASINO_WALLET_PRIVATE_KEY=your-private-key-here-CHANGE-THIS

# Transaction Settings
MIN_BUY_IN_KAS=0.1
MAX_BUY_IN_KAS=100
REQUIRED_CONFIRMATIONS=6
KASPA_POLL_INTERVAL_MS=1000

# Game Configuration
HOUSE_EDGE_PERCENT=1
MIN_PLAYERS_TO_START=2
MAX_PLAYERS_PER_LOBBY=10
LOBBY_WAIT_TIME_MS=15000
GAME_DURATION_MS=30000

# Provably Fair
ENABLE_PROVABLY_FAIR=true
SERVER_SEED_LENGTH=64
