{
  "name": "kaspump-backend",
  "version": "0.1.0",
  "description": "Backend for Klassik Pump multiplayer game",
  "main": "gameApi.js",
  "scripts": {
    "start": "node gameApi.js",
    "start:rush": "node rushGameServer.js",
