# ============================================
# RUSH GAME - KASPA BLOCKCHAIN CASINO
# Environment Configuration Template
# ============================================
# Copy this to .env in both /backend and /frontend directories
# NEVER commit actual .env files with real credentials!

# ============================================
# Backend Configuration (.env in root or /backend)
# ============================================

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL for game state, player data, transaction history)
DATABASE_URL=postgresql://klassik:password@localhost:5432/klassik_casino

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# Redis (for real-time game state caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# KASPA BLOCKCHAIN CONFIGURATION
# ============================================

# Kaspa Network (mainnet/testnet/simnet)
KASPA_NETWORK=testnet

# Kaspa API Endpoints
KASPA_REST_API=https://api.kaspa.org
KASPA_GRPC_SERVER=api.kaspa.org:16210

# Casino Hot Wallet (receives player buy-ins)
# SECURITY: Use environment variables or secret manager in production!
CASINO_KASPA_ADDRESS=kaspa:qr25pe5pfa4mhs8slw3dvxud4x55zx73tkz4xnpfyudnf7j8czzlsvf3vksdc
CASINO_WALLET_PRIVATE_KEY=your-private-key-here-NEVER-COMMIT-THIS

# Transaction Settings
MIN_BUY_IN_KAS=0.1
MAX_BUY_IN_KAS=100
REQUIRED_CONFIRMATIONS=6
KASPA_POLL_INTERVAL_MS=1000

# ============================================
# RUSH GAME SETTINGS
# ============================================

# Game Economics
HOUSE_EDGE_PERCENT=1
MIN_PLAYERS_TO_START=2
MAX_PLAYERS_PER_LOBBY=10
LOBBY_WAIT_TIME_MS=15000
GAME_DURATION_MS=30000

# Provably Fair
ENABLE_PROVABLY_FAIR=true
SERVER_SEED_LENGTH=64

# ============================================
# Frontend Configuration (.env in /frontend)
# ============================================

# API Backend
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# Kaspa Wallet Extension
VITE_KASPA_NETWORK=testnet

# Feature Flags
VITE_ENABLE_MOCK_WALLET=true
VITE_ENABLE_DEBUG_MODE=false

# ============================================
# PRODUCTION DEPLOYMENT
# ============================================

# Production URLs (set these in production .env)
# CORS_ORIGIN=https://yourdomain.com
# VITE_API_URL=https://api.yourdomain.com
# VITE_WS_URL=wss://api.yourdomain.com
# KASPA_NETWORK=mainnet
# ENABLE_MOCK_WALLET=false

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_PERFORMANCE_MONITORING=true

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
