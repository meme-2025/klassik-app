# Kaspa Full-Stack Infrastructure - Production Environment Variables
# klassik.99pace.space - Industrial Grade Blockchain Explorer

# =============================================================================
# KASPA NODE CONFIGURATION
# =============================================================================
KASPAD_HOST=127.0.0.1:16110
KASPAD_WRPC_URL=ws://127.0.0.1:16110
KASPA_NETWORK=mainnet
NETWORK_TYPE=mainnet

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
POSTGRES_DB=kaspa
POSTGRES_USER=kaspa
POSTGRES_PASSWORD=kaspapass123
POSTGRES_HOST=172.20.0.10
POSTGRES_PORT=5432
SQL_URI=postgresql+asyncpg://kaspa:kaspapass123@postgres:5432/kaspa

# =============================================================================
# KASPA REST-SERVER SETTINGS (10 BPS Optimized)
# =============================================================================
BPS=10
SQL_POOL_SIZE=25
SQL_POOL_MAX_OVERFLOW=10
SQL_POOL_RECYCLE_SECONDS=1800
HEALTH_TOLERANCE_DOWN=300

# Feature Flags
DISABLE_PRICE=false
USE_SCRIPT_FOR_ADDRESS=false
PREV_OUT_RESOLVED=false
TX_SEARCH_ID_LIMIT=1000
TX_SEARCH_BS_LIMIT=100
VSPC_REQUEST=false
TRANSACTION_COUNT=true
ADDRESSES_ACTIVE_COUNT=true
HASHRATE_HISTORY=true
ADDRESS_RANKINGS=false

# =============================================================================
# INDEXER CONFIGURATION
# =============================================================================
MIGRATION=true
BATCH_SIZE=1000
PARALLEL_WORKERS=4

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
REACT_APP_API_URL=https://klassik.99pace.space/api
REACT_APP_WS_URL=wss://klassik.99pace.space/ws
NODE_ENV=production
GENERATE_SOURCEMAP=false

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
GRAFANA_PASSWORD=klassik_admin_2026!
GF_SERVER_ROOT_URL=https://klassik.99pace.space/monitoring
GF_SECURITY_ADMIN_PASSWORD=klassik_admin_2026!

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
DOMAIN_NAME=klassik.99pace.space
SSL_EMAIL=admin@99pace.space
CERTBOT_EMAIL=admin@99pace.space

# =============================================================================
# LOGGING AND DEBUG
# =============================================================================
DEBUG=false
LOG_LEVEL=info

# =============================================================================
# DOCKER RESOURCE LIMITS
# =============================================================================
POSTGRES_MEMORY_LIMIT=2G
INDEXER_MEMORY_LIMIT=2G
REST_SERVER_MEMORY_LIMIT=2G
FRONTEND_MEMORY_LIMIT=512M
PROMETHEUS_MEMORY_LIMIT=1G
GRAFANA_MEMORY_LIMIT=512M

# =============================================================================
# NGINX CONFIGURATION
# =============================================================================
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
RATE_LIMIT_API=10r/s
RATE_LIMIT_GENERAL=5r/s