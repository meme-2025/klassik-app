# Multi-stage build for Kaspa Explorer
FROM node:18-alpine as build

WORKDIR /app

# Clone official kaspa-explorer
RUN apk add --no-cache git
RUN git clone https://github.com/kaspa-ng/kaspa-explorer.git .

# Install dependencies
RUN npm install

# Build arguments for API configuration
ARG API_URL=http://localhost:8080
ARG WEBSOCKET_URL=ws://localhost:8080

# Set environment variables
ENV REACT_APP_API_URL=${API_URL}
ENV REACT_APP_WS_URL=${WEBSOCKET_URL}
ENV GENERATE_SOURCEMAP=false
ENV NODE_ENV=production

# Build the React application
RUN npm run build

# Production stage with Nginx
FROM nginx:alpine

# Copy built app to nginx
COPY --from=build /app/build /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Create nginx user if doesn't exist
RUN adduser -D -S -h /var/cache/nginx -s /sbin/nologin -G nginx nginx || true

# Set proper permissions
RUN chown -R nginx:nginx /usr/share/nginx/html
RUN chmod -R 755 /usr/share/nginx/html

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]