# Frontend Environment Variables
# These will be baked into the build

# API Configuration
NEXT_PUBLIC_API_URL=https://klassik.99pace.space/api
NEXT_PUBLIC_WS_URL=wss://klassik.99pace.space/ws

# Network
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_NETWORK_NAME=Kaspa Mainnet

# Features
NEXT_PUBLIC_ENABLE_DAG_VISUALIZATION=true
NEXT_PUBLIC_BLOCKS_PER_SECOND=10
NEXT_PUBLIC_MAX_CACHED_BLOCKS=1000

# Performance
NEXT_PUBLIC_POLLING_INTERVAL=100
NEXT_PUBLIC_ENABLE_WEBSOCKET=true

# Analytics (optional)
# NEXT_PUBLIC_GA_TRACKING_ID=

# Node Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
