# ========================================
# KLASSIK GAMING PLATFORM - ENVIRONMENT VARIABLES
# ========================================

# APPLICATION
NODE_ENV=development
APP_NAME="Klassik Gaming"

# BACKEND
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:3000

# FRONTEND
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=klassik
DB_PASSWORD=klassik_dev_password_change_in_production
DB_DATABASE=klassik_gaming
DB_SYNC=false
DB_LOGGING=true

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# KASPA BLOCKCHAIN
KASPA_NETWORK=testnet-10
KASPA_REST_API=https://api.kaspa.org
KASPA_INDEXER_URL=https://api.kaspa.org
CASINO_KASPA_ADDRESS=kaspa:qz...YOUR_CASINO_WALLET_ADDRESS_HERE
CASINO_WALLET_PRIVATE_KEY=YOUR_PRIVATE_KEY_KEEP_SECRET
REQUIRED_CONFIRMATIONS=6
KASPA_POLL_INTERVAL_MS=1000

# GAME SETTINGS
MIN_BUY_IN_KAS=0.1
MAX_BUY_IN_KAS=100
HOUSE_EDGE_PERCENT=2
MAX_PLAYERS_PER_LOBBY=10
MIN_PLAYERS_TO_START=2
COUNTDOWN_DURATION_MS=15000
MIN_CRASH_POINT=1.01
MAX_CRASH_POINT=100.0

# SECURITY
JWT_SECRET=change_this_to_a_random_secret_key_in_production
JWT_EXPIRES_IN=7d
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# MONITORING (Optional)
SENTRY_DSN=
LOG_LEVEL=debug
