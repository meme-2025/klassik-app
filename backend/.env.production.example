# ═══════════════════════════════════════════════════════════
# KLASSIK PRODUCTION ENVIRONMENT
# ═══════════════════════════════════════════════════════════
# 
# Copy to: /etc/klassik/klassik1.env
# Permissions: chmod 600 /etc/klassik/klassik1.env
# Owner: chown klassik:klassik /etc/klassik/klassik1.env
#
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_NAME=Klassik Gaming Platform

# ─────────────────────────────────────────────────────────────
# CORS & SECURITY
# ─────────────────────────────────────────────────────────────

CORS_ORIGIN=https://klassik.99pace.space
ALLOWED_ORIGINS=https://klassik.99pace.space,http://klassik.99pace.space

# ─────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://klassik3_writer:CHANGE_ME_STRONG_PASSWORD@localhost:5432/klassik3_production

# Alternative format:
DB_HOST=localhost
DB_PORT=5432
DB_USER=klassik3_writer
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=klassik3_production

# Connection pooling
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────────────────────────

# CRITICAL: Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING_OR_MORE
JWT_EXPIRY=7d

# ─────────────────────────────────────────────────────────────
# KASPA BLOCKCHAIN
# ─────────────────────────────────────────────────────────────

# Sacrifice wallet address (PRODUCTION)
KASPA_SACRIFICE_ADDRESS=kaspa:qr25pe5pfa4mhs8slw3dvxud4x55zx73tkz4xnpfyudnf7j8czzlsvf3vksdc

# Kaspa API endpoints
KASPA_REST_SERVER=https://api.kaspa.org
KASPA_API_PRIMARY=https://api.kaspa.org
KASPA_EXPLORER_API=https://explorer.kaspa.org/api

# Polling intervals (milliseconds)
SAC_POLL_INTERVAL=15000
KASPA_POLL_INTERVAL=10000

# Payment requirements
MIN_POINTS_REQUIRED=100
POINTS_PER_KAS=100
REQUIRED_CONFIRMATIONS=6

# ─────────────────────────────────────────────────────────────
# ADMIN PANEL
# ─────────────────────────────────────────────────────────────

# Admin wallet addresses (comma-separated)
ADMIN_WALLETS=0x2a04B64d4641CdA7271289D2da6BbF27de02D823

# IP Whitelist (optional, leave empty to allow all)
ADMIN_IPS=

# ─────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────

RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW=60000

RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=900000

RATE_LIMIT_REGISTRATION_MAX=3
RATE_LIMIT_REGISTRATION_WINDOW=3600000

RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_PAYMENT_WINDOW=60000

# ─────────────────────────────────────────────────────────────
# GAME SETTINGS
# ─────────────────────────────────────────────────────────────

MIN_BUY_IN_KAS=0.1
MAX_BUY_IN_KAS=100
HOUSE_EDGE_PERCENT=2

# Session timeouts
GAME_SESSION_TIMEOUT=1800000
GAME_CLEANUP_INTERVAL=300000

# ─────────────────────────────────────────────────────────────
# SERVICES (Enable/Disable)
# ─────────────────────────────────────────────────────────────

ENABLE_SACRIFICE_WATCHER=true
ENABLE_BLOCKCHAIN_MONITOR=true
ENABLE_GAME_ENGINE=true
ENABLE_MONITORING=true
ENABLE_KLASSIK=false
ENABLE_WATCHER=false

# ─────────────────────────────────────────────────────────────
# REDIS (Optional - for caching)
# ─────────────────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────

LOG_LEVEL=info
LOG_FILE=/var/log/klassik/app.log

# ─────────────────────────────────────────────────────────────
# MONITORING (Optional)
# ─────────────────────────────────────────────────────────────

SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ─────────────────────────────────────────────────────────────
# DEVELOPMENT OVERRIDES (Remove in production)
# ─────────────────────────────────────────────────────────────

# NODE_ENV=development
# LOG_LEVEL=debug
# ENABLE_SACRIFICE_WATCHER=false
