{
  "name": "klassik-backend",
  "version": "1.0.0",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:YOUR_USER/YOUR_REPO.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "production": "NODE_ENV=production node src/index.js",
    "migrate:up": "node run-migration.js up",
    "migrate:down": "node run-migration.js down",
    "migrate:reset": "node run-migration.js reset",
    "migrate:create": "DOTENV_CONFIG_PATH=/etc/klassik/klassik1.env node -r dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate create",
    "seed": "node scripts/seed-products.js",
    "db:setup": "npm run migrate:up && npm run seed",
    "check-schema": "node check-schema.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "echo \"No linter configured yet\" && exit 0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-redis": "^7.1.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.0.3",
    "ethers": "^6.8.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "sharp": "^0.33.0",
    "siwe": "^3.0.0",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  }
}
