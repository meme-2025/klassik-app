// Production environment configuration template
// File: backend/.env.production

# =================================
# KLASSIK PRODUCTION CONFIGURATION
# =================================

# Environment
NODE_ENV=production

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS Configuration (Set your actual domain)
CORS_ORIGIN=https://yourdomain.com

# Database Configuration (Will be set by deployment script)
DATABASE_URL=postgresql://klassik:GENERATED_PASSWORD@localhost:5432/klassik

# Security (Will be generated by deployment script)
JWT_SECRET=GENERATED_SECRET
JWT_EXPIRY=7d
SESSION_SECRET=GENERATED_SECRET
ADMIN_TOKEN=GENERATED_ADMIN_TOKEN

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kaspa Blockchain Configuration
KASPA_REST_SERVER=http://localhost:8080
KASPA_GRPC_SERVER=localhost:16210

# Sacrifice System Configuration
KASPA_SACRIFICE_ADDRESS=kaspa:qr25pe5pfa4mhs8slw3dvxud4x55zx73tkz4xnpfyudnf7j8czzlsvf3vksdc
POINTS_PER_KAS=100
MIN_POINTS_REQUIRED=1

# Blockchain Monitoring
ENABLE_BLOCKCHAIN_MONITOR=true
KASPA_POLL_INTERVAL=10000
PAYMENT_CONFIRMATION_BLOCKS=6

# Service Configuration
ENABLE_WATCHER=true
ENABLE_KLASSIK=true
ENABLE_COMMUNITY_FEATURES=true

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=/var/log/klassik

# File Upload Configuration
UPLOAD_DIR=/opt/klassik/shared/uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=5

# Session Configuration
SESSION_MAX_AGE=604800000
SESSION_SECURE=true

# External APIs
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Monitoring and Health Checks
HEALTH_CHECK_INTERVAL=30000
ENABLE_METRICS=true

# Deployment Information
APP_DIR=/opt/klassik
BACKUP_DIR=/opt/klassik/backups

# Email Configuration (Optional - for notifications)
# SMTP_HOST=your-smtp-server.com
# SMTP_PORT=587
# SMTP_USER=your-email@domain.com
# SMTP_PASS=your-email-password
# FROM_EMAIL=noreply@yourdomain.com

# Webhook Configuration (Optional - for alerts)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# SSL Configuration (Handled by nginx in production)
SSL_ENABLED=false

# Production Optimization
GZIP_ENABLED=true
CACHE_STATIC_ASSETS=true
CACHE_MAX_AGE=31536000

# Security Headers (Handled by nginx)
SECURITY_HEADERS_ENABLED=false