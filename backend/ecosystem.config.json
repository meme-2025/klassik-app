{
  "apps": [
    {
      "name": "klassik-production",
      "script": "./src/server.js",
      "cwd": "/home/klassik/backend",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3000,
        "HOST": "0.0.0.0"
      },
      "env_file": "/etc/klassik/klassik1.env",
      "error_file": "/var/log/klassik/error.log",
      "out_file": "/var/log/klassik/out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "500M",
      "min_uptime": "10s",
      "max_restarts": 10,
      "kill_timeout": 5000,
      "wait_ready": true,
      "listen_timeout": 10000,
      "shutdown_with_message": true
    }
  ]
}
