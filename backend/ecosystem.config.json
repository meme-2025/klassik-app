{
  "apps": [
    {
      "name": "klassik-production",
      "script": "./src/index.js",
      "cwd": "/opt/klassik/backend",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": 8130,
        "HOST": "0.0.0.0",
        "ENABLE_WATCHER": "false",
        "ENABLE_BLOCKCHAIN_MONITOR": "true",
        "ENABLE_KLASSIK": "false",
        "KASPA_API_SERVER": "https://api.kaspa.org",
        "KASPA_POLL_INTERVAL": "30000",
        "JWT_SECRET": "a1b2c3d4e5f6789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890"
      },
      "error_file": "/var/log/klassik/error.log",
      "out_file": "/var/log/klassik/out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "500M",
      "min_uptime": "10s",
      "max_restarts": 10,
      "kill_timeout": 5000,
      "wait_ready": true,
      "listen_timeout": 10000,
      "shutdown_with_message": true
    }
  ]
}
