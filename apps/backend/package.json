    "@nestjs/websockets": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/schedule": "^4.0.0",
    "typeorm": "^0.3.20",
    "pg": "^8.11.3",
    "ioredis": "^5.3.2",
    "socket.io": "^4.7.0",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "uuid": "^9.0.1",
