    "eslint": "^8.56.0",
    "typescript": "^5.4.2",
    "ts-node": "^10.9.2",
    "ts-loader": "^9.5.0",
    "tsconfig-paths": "^4.2.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  }
