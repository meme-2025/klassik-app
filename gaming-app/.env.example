# App Config
NODE_ENV=development
APP_NAME="Kaspa Rush"
APP_URL=http://localhost:3000

# Backend API
BACKEND_URL=http://localhost:4000
BACKEND_WS_URL=ws://localhost:4000

# Database
DATABASE_URL=postgresql://kaspa_user:kaspa_password@localhost:5432/kaspa_rush
REDIS_URL=redis://localhost:6379

# Kaspa Blockchain
KASPA_NODE_URL=http://localhost:16110
KASPA_NETWORK=mainnet
KASPA_INDEXER_URL=http://localhost:8080

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRATION=7d
SESSION_SECRET=your-session-secret-change-this

# Game Config
MIN_BET_AMOUNT=0.1
MAX_BET_AMOUNT=1000
HOUSE_EDGE=0.02
MAX_MULTIPLIER=100

# Admin
ADMIN_EMAIL=admin@kasparush.io
ADMIN_PASSWORD=change-this-password

# Analytics & Monitoring
SENTRY_DSN=
POSTHOG_KEY=
