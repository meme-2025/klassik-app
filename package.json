{
  "name": "klassik-gaming-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Klassik Gaming Platform - Kaspa BlockDAG Integration",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "backend:dev": "pnpm --filter @klassik/backend dev",
    "web:dev": "pnpm --filter @klassik/web dev",
    "install:all": "pnpm install",
    "explorer:build": "npm run explorer:build:css && npm run explorer:build:js",
    "explorer:build:css": "cssnano frontend/assets/css/kaspa-explorer-v4.css -o frontend/assets/css/kaspa-explorer-v4.min.css && cssnano frontend/assets/css/explorer-compact-v3.css -o frontend/assets/css/explorer-compact-v3.min.css",
    "explorer:build:js": "terser frontend/assets/js/kaspa-explorer.js -o frontend/assets/js/kaspa-explorer.min.js --compress --mangle && terser frontend/assets/js/realtime-updates.js -o frontend/assets/js/realtime-updates.min.js --compress --mangle && terser frontend/assets/js/bandwidth-monitor.js -o frontend/assets/js/bandwidth-monitor.min.js --compress --mangle",
    "explorer:watch": "npm-watch",
    "explorer:production": "npm run explorer:build && node scripts/update-html-references.js"
  },
  "watch": {
    "explorer:build:css": {
      "patterns": ["frontend/assets/css/*.css"],
      "extensions": "css",
      "quiet": false
    },
    "explorer:build:js": {
      "patterns": ["frontend/assets/js/*.js"],
      "extensions": "js",
      "quiet": false
    }
  },
  "devDependencies": {
    "turbo": "^1.12.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.2",
    "cssnano-cli": "^1.0.5",
    "terser": "^5.31.0",
    "npm-watch": "^0.13.0",
    "html-minifier-terser": "^7.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
